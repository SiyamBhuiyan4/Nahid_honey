# Copy to .env for local use (start_server.sh loads it). On Vercel set these in
# Project → Settings → Environment Variables. Never commit real values.

# --- Storage -----------------------------------------------------------------
# telegram | pgsql | sqlite. Default: pgsql if DATABASE_URL is set, telegram on
# Vercel, sqlite locally (storage/store.sqlite).
STORE_DRIVER=telegram

# --- Telegram (bot must be an admin of the channel: post, edit, pin, delete) ---
# Create/rotate the token with @BotFather (/revoke then /token).
TELEGRAM_BOT_TOKEN=
# Channel used for order notifications and media, e.g. -100xxxxxxxxxx
TELEGRAM_CHANNEL_ID=
TELEGRAM_CHANNEL_LINK=
# Optional: a separate private channel just for the store data (recommended).
# Defaults to TELEGRAM_CHANNEL_ID.
TELEGRAM_DB_CHANNEL_ID=
# Optional: message id of the pinned "NAHID_HONEY_DB_INDEX" message. Only needed
# if something else gets pinned on top of it in the data channel.
TELEGRAM_DB_INDEX_MSG_ID=
# Optional: encrypt the data files stored in Telegram (AES-256-GCM). If you set
# it, keep it forever — without it the data cannot be read.
TELEGRAM_DB_KEY=
# Optional: seconds the index may be cached between requests (default 3).
TELEGRAM_DB_INDEX_TTL=3

# --- Security ------------------------------------------------------------------
# Signs admin login cookies and CSRF tokens. 64 random hex chars:
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Changing it signs everyone out.
APP_SECRET=

# --- Optional: Postgres instead of Telegram (e.g. free Neon database) ------------
# DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# --- Optional: local SQLite file path (default storage/store.sqlite) -----------
SQLITE_PATH=
